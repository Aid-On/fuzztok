{
  "name": "@aid-on/fuzztok",
  "version": "1.0.0",
  "description": "高速・軽量なファジートークン推定ライブラリ - Fast and lightweight fuzzy token estimation library with CJK support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build && npm run type-check",
    "demo:dev": "vite demo",
    "demo:build": "vite build",
    "demo:preview": "vite preview demo",
    "deploy:manual": "npm run build && npm run demo:build && npx --yes gh-pages@6.3.0 -d demo-dist"
  },
  "keywords": [
    "token",
    "estimation",
    "llm",
    "fuzzy",
    "cjk",
    "japanese",
    "chinese",
    "korean",
    "multilingual",
    "typescript"
  ],
  "author": "aid-on",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.57.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aid-On/fuzztok.git"
  },
  "homepage": "https://aid-on.github.io/fuzztok/",
  "bugs": {
    "url": "https://github.com/Aid-On/fuzztok/issues"
  },
  "overrides": {
    "esbuild@0.21.5": "~0.25.0",
    "tinypool@0.8.4": "^2.1.2",
    "@vitest/mocker@3.2.7": "^4.1.11",
    "tinypool@1.1.1": "^2.1.2"
  }
}
